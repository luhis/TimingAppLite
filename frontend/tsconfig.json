{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["jest", "node"],
  },
  "ignoreDeprecations": "6.0",
  "include": [
    "src/**/*",
    "gatsby-node.ts",
    "gatsby-config.ts",
    "plugins/**/*"
  ]
}
