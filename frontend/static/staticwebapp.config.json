{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/static/*",
      "/icons/*",
      "/workbox-v*",
      "/*.{css,js,png,jpg,jpeg,gif,svg,ico,woff,woff2,ttf,eot,webmanifest,json}"
    ]
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "name": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "name": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
