{
  "name": "timing-app-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Gatsby TypeScript leaderboard app for Sapphire Solutions autotest results",
  "author": "Matt McCorry",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx} --cache --cache-location .eslintcache",
    "lint:fix": "eslint src/**/*.{js,jsx,ts,tsx} --cache --cache-location .eslintcache --fix",
    "format": "prettier --write \"**/*.{js,jsx,tsx,ts,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@creativebulma/bulma-tooltip": "^1.2.0",
    "@microsoft/signalr": "^10.0.0",
    "bulma": "^1.0.4",
    "gatsby": "^5.6.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-preact": "^7.16.0",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.2.7",
    "react-bulma-components": "^4.1.0",
    "react-dom": "^19.2.7",
    "ts-date": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  }
}
